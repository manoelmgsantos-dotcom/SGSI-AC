# ==============================================================================
# AC ENGENHARIA - CYBERGRC & SGSI ENTERPRISE PLATFORM
# VARIÁVEIS DE AMBIENTE (PRODUÇÃO / VPS DOCKER COMPOSE)
# ==============================================================================

# Portas públicas onde o Frontend Nginx ficará disponível na VPS
FRONTEND_PORT=80
APP_PORT=3000

# Porta interna do container Backend API (Express)
PORT=3001
NODE_ENV=production

# ------------------------------------------------------------------------------
# BANCO DE DADOS POSTGRESQL 17
# ------------------------------------------------------------------------------
POSTGRES_DB=cybergrc
POSTGRES_USER=cybergrc
# ATENÇÃO: Defina sua senha real no arquivo .env da VPS!
POSTGRES_PASSWORD=change-this-password

# URL de Conexão com o PostgreSQL (No Docker Compose o host é "db")
DATABASE_URL=postgresql://cybergrc:change-this-password@db:5432/cybergrc

# ------------------------------------------------------------------------------
# CREDENCIAIS DO ADMINISTRADOR PRINCIPAL (MASTER SETUP)
# ------------------------------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=manoelmgsantos@acengenhariase.com.br
BOOTSTRAP_ADMIN_PASSWORD=change-this-password

# ------------------------------------------------------------------------------
# SEGURANÇA E SESSÃO CRIPTOGRÁFICA (HMAC-SHA256)
# ------------------------------------------------------------------------------
# Gere uma chave aleatória forte para assinatura dos tokens e sessões
SESSION_SECRET=gere-uma-chave-secreta-forte-aqui-ac-engenharia-2026

# Domínio da sua VPS ou servidor (ex: sgsi.acengenhariase.com.br)
APP_DOMAIN=localhost

# ------------------------------------------------------------------------------
# GOOGLE WORKSPACE SSO (@acengenhariase.com.br)
# ------------------------------------------------------------------------------
# Client ID OAuth 2.0 obtido no Google Cloud Console:
GOOGLE_CLIENT_ID=
