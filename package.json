{
  "name": "ac-construtora-sgsi-grc-de-obras",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "start": "node ./scripts/dev.mjs",
    "start:prod": "node dist-server/index.mjs",
    "tunnel": "node ./scripts/tunnel.mjs",
    "db:setup": "node scripts/setup-postgres.cjs",
    "db:reset": "node scripts/reset-db.mjs",
    "build": "node scripts/build.mjs",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --outfile=dist-server/index.mjs --external:bcryptjs --external:pg --external:express --external:dotenv --external:express-session",
    "preview": "vite preview",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "pg": "^8.23.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
